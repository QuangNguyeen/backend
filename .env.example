# DictaLearn Backend Environment Variables
# Copy this file to .env and update values

# Environment: development | staging | production
ENVIRONMENT=development
# DEBUG enables SQL echo and exposes error details; keep OFF in production.
DEBUG=true
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dictalearn

# JWT Secret (generate with: openssl rand -hex 32)
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — JSON list OR comma-separated, e.g.
#   CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://dictalearnvn.com","https://www.dictalearnvn.com","https://dictalearn-react.nvquang176.workers.dev"]

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# AssemblyAI
ASSEMBLYAI_API_KEY=

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
