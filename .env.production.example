# DictaLearn — production env template. Copy to .env trên server và điền giá trị thật.
# KHÔNG commit file .env thật.

# App
DEBUG=False
APP_NAME=DictaLearn API

# Database (trỏ tới service 'db' trong compose)
DATABASE_URL=postgresql+asyncpg://dictalearn:CHANGE_ME@db:5432/dictalearn
POSTGRES_USER=dictalearn
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=dictalearn

# JWT — sinh bằng: openssl rand -hex 32
SECRET_KEY=GENERATE_WITH_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS — origin frontend production. Chấp nhận cả 2 dạng:
#   - phân tách bằng dấu phẩy: https://a.com,https://b.com
#   - JSON array:              ["https://a.com","https://b.com"]
CORS_ORIGINS=https://dictalearnvn.com,https://www.dictalearnvn.com,https://dictalearn-react.nvquang176.workers.dev
# Redis (Celery broker/result + SSE pub/sub)
REDIS_URL=redis://redis:6379/0

# AI / Google
GEMINI_API_KEY=
ASSEMBLYAI_API_KEY=
# Comma-separated list: web + native iOS/Android client IDs.
GOOGLE_CLIENT_ID=
GCP_PROJECT_ID=
GCS_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=/app/gcp-credentials.json

# YouTube proxy (tùy chọn) — residential proxy để vượt chặn IP datacenter.
# Để trống = tắt. Định dạng: http://user:pass@host:port
YT_PROXY_URL=

# CI/CD image (GHCR)
GHCR_OWNER=your-github-user
IMAGE_TAG=latest
